# Next.js loads .env.local or .env — not this file.
# Copy this file to .env.local, set your real values, then restart: npm run dev

NEXT_PUBLIC_GITHUB_URL="https://github.com/your-username"
# Open-to-work badge and profile status dot (true | false)
NEXT_PUBLIC_OPEN_TO_WORK=true
# Simple option: plain email (handy in dev)
# NEXT_PUBLIC_CONTACT_EMAIL="you@example.com"
# Obfuscated option: base64-encoded email (PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("you@example.com")))
NEXT_PUBLIC_CONTACT_EMAIL_B64="ZXhhbXBsZUBkZW1vLmNvbQ=="

# Spotify playlist -> AudioLines button in the footer (right-side icon)
# Playlist ID (preferred) OR full open.spotify.com/playlist/... URL
NEXT_PUBLIC_SPOTIFY_PLAYLIST_ID=""
# NEXT_PUBLIC_SPOTIFY_PLAYLIST_URL="https://open.spotify.com/playlist/xxxxxxxx"

# --- Chatbot (route /api/chat) ---
# gemini (default in code) | openai
AI_PROVIDER=gemini
# One-time setup for dynamic age answer (ISO format: YYYY-MM-DD)
# JULIE_BIRTHDATE="1993-04-09"
# Optional: force a specific zodiac sign (otherwise derived from JULIE_BIRTHDATE)
# JULIE_ASTRO_SIGN="Capricorne"
# Ascendant is manual (cannot be derived without birth time/place)
# JULIE_ASCENDANT="Scorpion"
GEMINI_API_KEY=""
# GEMINI_MODEL=gemini-2.0-flash
# OPENAI_API_KEY=""
# OPENAI_CHAT_MODEL=gpt-4o-mini
