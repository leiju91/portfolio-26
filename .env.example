# Next.js loads .env.local or .env — not this file.
# Copy this file to .env.local, set your real values, then restart: npm run dev

NEXT_PUBLIC_GITHUB_URL="https://github.com/your-username"
# Simple option: plain email (handy in dev)
# NEXT_PUBLIC_CONTACT_EMAIL="you@example.com"
# Obfuscated option: base64-encoded email (PowerShell: [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("you@example.com")))
NEXT_PUBLIC_CONTACT_EMAIL_B64="ZXhhbXBsZUBkZW1vLmNvbQ=="

# Spotify playlist → bouton AudioLines dans le footer (icône à droite)
# ID de la playlist (préféré) OU lien complet open.spotify.com/playlist/...
NEXT_PUBLIC_SPOTIFY_PLAYLIST_ID=""
# NEXT_PUBLIC_SPOTIFY_PLAYLIST_URL="https://open.spotify.com/playlist/xxxxxxxx"
