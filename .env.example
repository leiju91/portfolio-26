# Next.js charge .env.local ou .env — pas ce fichier.
# Copie ce fichier en .env.local, mets tes vraies valeurs, puis redémarre : npm run dev

NEXT_PUBLIC_GITHUB_URL="https://github.com/your-username"
# Option simple : email en clair (recommandé en dev)
# NEXT_PUBLIC_CONTACT_EMAIL="you@example.com"
# Option obfusquée : base64 de l’email (PowerShell : [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes("you@example.com")))
NEXT_PUBLIC_CONTACT_EMAIL_B64="ZXhhbXBsZUBkZW1vLmNvbQ=="
